// Settings for sounds
#macro AV_PRIORITY 0
#macro AV_GAIN .5
#macro AV_QUESTION_LOOKAHEAD 5

// If true increases pitch of characters near a questionmark
#macro AV_ALLOW_QUESTIONS true


// Only change this if you are adding / removing sounds in the project 
enum animalvoice_list {
	normal,
	robot,
	grumpy,
	scratchy,
	tired
}