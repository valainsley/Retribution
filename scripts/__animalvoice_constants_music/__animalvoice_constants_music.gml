	monotone,
	major,
	harmonic_minor,
	melodic_minor,
	blues_scale,
	chromatic_scale,
	pentatonic_scale,
	diminished_scale,
	dorian_scale,
	japenese_mode,
	phrygian,
	hungarian_minor,
	persion
}